{
  "name": "pagepal",
  "version": "1.0.0",
  "description": "A mascot that reacts to what is happening on your page, plus first-party UX analytics: rage and dead clicks, form errors and abandonment, failing requests, offline time.",
  "keywords": [
    "mascot",
    "companion",
    "feedback",
    "ux",
    "ux-analytics",
    "rage-clicks",
    "dead-clicks",
    "form-analytics",
    "forms",
    "fetch",
    "xhr",
    "web-component",
    "react",
    "vue"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/element.js",
    "./dist/element.cjs",
    "./dist/pagepal.global.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/pagepal.global.js",
  "jsdelivr": "./dist/pagepal.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./watchers": {
      "import": {
        "types": "./dist/watchers.d.ts",
        "default": "./dist/watchers.js"
      },
      "require": {
        "types": "./dist/watchers.d.cts",
        "default": "./dist/watchers.cjs"
      }
    },
    "./characters": {
      "import": {
        "types": "./dist/characters.d.ts",
        "default": "./dist/characters.js"
      },
      "require": {
        "types": "./dist/characters.d.cts",
        "default": "./dist/characters.cjs"
      }
    },
    "./analytics": {
      "import": {
        "types": "./dist/analytics.d.ts",
        "default": "./dist/analytics.js"
      },
      "require": {
        "types": "./dist/analytics.d.cts",
        "default": "./dist/analytics.cjs"
      }
    },
    "./debug": {
      "import": {
        "types": "./dist/debug.d.ts",
        "default": "./dist/debug.js"
      },
      "require": {
        "types": "./dist/debug.d.cts",
        "default": "./dist/debug.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element.d.ts",
        "default": "./dist/element.js"
      },
      "require": {
        "types": "./dist/element.d.cts",
        "default": "./dist/element.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/size.mjs",
    "e2e": "npm run build && playwright test",
    "e2e:update": "npm run build && playwright test --update-snapshots",
    "demo": "npm run build && node scripts/serve.mjs 5173",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run size"
  },
  "peerDependencies": {
    "react": ">=17",
    "vue": ">=3.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3",
    "vue": "^3.5.43"
  }
}
